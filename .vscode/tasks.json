                    "/C",
                    "ejecutar.bat"
                ]
            }
        },
        {
            "label": "Limpiar compilacion",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": [],
            "windows": {
                "command": "cmd",
                "args": [
                    "/C",
                    "limpiar.bat"
                ]
            }
        }
    ]
